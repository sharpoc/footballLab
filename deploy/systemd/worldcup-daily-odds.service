[Unit]
Description=Worldcup daily odds sidecar refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=worldcup
Group=worldcup
WorkingDirectory=/opt/worldcup/current
EnvironmentFile=/etc/worldcup/.env
Environment=WORLDCUP_DAILY_ODDS_DATA_DIR=/var/lib/worldcup/daily_odds
ExecStart=/usr/bin/python3 -m worldcup.daily_sidecar --live --env /etc/worldcup/.env --data-dir /var/lib/worldcup/daily_odds --daily-budget-credits 85
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/worldcup/daily_odds
UMask=0077
